{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "stores/**/*.ts"
  ],
  "exclude": [
    "app-example",
    "node_modules",
    "temp-assets"
  ]
}
