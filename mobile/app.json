{
  "expo": {
    "name": "ReceiptAI",
    "slug": "receiptai",
    "scheme": "receiptai",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "experiments": {
      "baseUrl": "/app"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajay.receiptai",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080810"
      },
      "package": "com.ajay.receiptai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ReceiptAI to use your microphone for voice questions.",
          "speechRecognitionPermission": "Allow ReceiptAI to recognize speech for AI Agent questions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.samsung.android.bixby.agent"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReceiptAI to access your photos to scan receipts.",
          "cameraPermission": "Allow ReceiptAI to use your camera to scan receipts."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2325e79c-ae59-428e-b502-f1c9b971bccd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2325e79c-ae59-428e-b502-f1c9b971bccd"
    }
  }
}
