# Copy these names into a separate Railway staging environment.
# Replace every your_* value in Railway; never commit real credentials.
APP_ENV=staging
PUBLIC_BASE_URL=https://your-staging-service.up.railway.app
PASSWORD_RESET_REDIRECT_URL=https://your-staging-service.up.railway.app/reset-password/
CORS_ALLOWED_ORIGINS=https://your-staging-service.up.railway.app
SUPPORT_EMAIL=support@receiptai.app
LOG_JSON=true

ANTHROPIC_API_KEY=your_anthropic_api_key
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_KEY=your_staging_anon_key
SUPABASE_SERVICE_KEY=your_staging_service_key

# Enabled together only in staging for evaluation.
CLAUDE_PROMPT_CACHING_ENABLED=true
CLAUDE_STRUCTURED_OUTPUTS_ENABLED=true
CLAUDE_STRICT_TOOLS_ENABLED=true
CLAUDE_SCAN_CASCADE_ENABLED=true
CLAUDE_SCAN_MODEL=claude-sonnet-4-5-20250929
CLAUDE_SCAN_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_SCAN_CASCADE_MIN_CONFIDENCE=0.82
MAX_SCAN_IMAGE_TOKENS=1568
AGENT_HISTORY_MAX_MESSAGES=10
AGENT_HISTORY_MAX_CHARS=16000
AGENT_HISTORY_MESSAGE_MAX_CHARS=4000
