ANTHROPIC_API_KEY=your_anthropic_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081
SUPPORT_EMAIL=support@receiptai.app
# Optional first-deployment bootstrap; comma-separated Supabase auth user UUIDs.
RBAC_BOOTSTRAP_ADMIN_USER_IDS=

CLAUDE_AGENT_MODEL=claude-opus-4-5-20251101
CLAUDE_SONNET_MODEL=claude-sonnet-4-5-20250929
CLAUDE_SCAN_MODEL=claude-sonnet-4-5-20250929
CLAUDE_PLANNER_MODEL=claude-haiku-4-5-20251001
# Cost-safe default: caching does not change model selection or answer rules.
CLAUDE_PROMPT_CACHING_ENABLED=true
# Guarded rollout flags. Leave false until receipt/Agent evaluation passes.
CLAUDE_STRUCTURED_OUTPUTS_ENABLED=false
CLAUDE_STRICT_TOOLS_ENABLED=false
CLAUDE_SCAN_CASCADE_ENABLED=false
CLAUDE_SCAN_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_SCAN_CASCADE_MIN_CONFIDENCE=0.82
MAX_PDF_SCAN_PAGES=16
MAX_SCAN_IMAGE_PAGES=8
MAX_SCAN_OUTPUT_TOKENS=16000
MAX_SCAN_IMAGE_LONG_EDGE=1800
# Prevent high-resolution models from silently increasing image-token usage.
MAX_SCAN_IMAGE_TOKENS=1568
SCAN_IMAGE_JPEG_QUALITY=82
AGENT_HISTORY_MAX_MESSAGES=10
AGENT_HISTORY_MAX_CHARS=16000
AGENT_HISTORY_MESSAGE_MAX_CHARS=4000

# Production logging and operations Issues dashboard support.
LOG_LEVEL=INFO
LOG_JSON=false
SLOW_REQUEST_MS=3000
LOG_CLIENT_ERROR_EVENTS=true
AI_INPUT_COST_PER_MILLION_TOKENS=
AI_OUTPUT_COST_PER_MILLION_TOKENS=
AI_CACHE_READ_COST_PER_MILLION_TOKENS=
AI_CACHE_WRITE_COST_PER_MILLION_TOKENS=

# Optional: enables local receipt item vectors in Supabase pgvector.
RECEIPT_ITEM_EMBEDDING_MODEL=receiptai-local-hash-v1
RECEIPT_ITEM_EMBEDDINGS_ENABLED=true
AGENT_EMBEDDING_RETRIEVAL_ENABLED=true

PASSWORD_RESET_REDIRECT_URL=https://web-production-3605f4.up.railway.app/reset-password/

# Optional: Google Custom Search for public item meaning/aliases only.
# Receipt prices still come only from saved receipts.
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_google_programmable_search_engine_id
