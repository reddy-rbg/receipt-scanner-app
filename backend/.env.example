ANTHROPIC_API_KEY=your_anthropic_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Optional first-deployment bootstrap; comma-separated Supabase auth user UUIDs.
RBAC_BOOTSTRAP_ADMIN_USER_IDS=

CLAUDE_AGENT_MODEL=claude-opus-4-5-20251101
CLAUDE_SONNET_MODEL=claude-sonnet-4-5-20250929
CLAUDE_SCAN_MODEL=claude-sonnet-4-5-20250929

# Optional: enables local receipt item vectors in Supabase pgvector.
RECEIPT_ITEM_EMBEDDING_MODEL=receiptai-local-hash-v1
RECEIPT_ITEM_EMBEDDINGS_ENABLED=true
AGENT_EMBEDDING_RETRIEVAL_ENABLED=true

PASSWORD_RESET_REDIRECT_URL=https://web-production-3605f4.up.railway.app/reset-password/

# Optional: Google Custom Search for public item meaning/aliases only.
# Receipt prices still come only from saved receipts.
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_google_programmable_search_engine_id
